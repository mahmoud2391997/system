# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection URL (e.g., Neon or Postgres). If omitted, falls back to local durable JSON persistence.
DATABASE_URL=

# JWT_SECRET: Secret for signing session authentication tokens.
JWT_SECRET="nexus_dev_secret_key_change_in_production"

# ENCRYPTION_KEY: 32-byte hex key for AES-256-GCM token encryption.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google Workspace OAuth Credentials (Optional: can also be configured via Token Vault UI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
