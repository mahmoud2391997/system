# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection URL (e.g., Neon or Postgres). If omitted, falls back to local durable JSON persistence.
DATABASE_URL=

# JWT_SECRET: Secret for signing session authentication tokens.
# Set this in Vercel Project Settings → Environment Variables for production.
JWT_SECRET="nexus_dev_secret_key_change_in_production"

# ENCRYPTION_KEY: 32-byte hex key for AES-256-GCM token encryption.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google OAuth — required for the "Sign in with Gmail" button (accounts.google.com).
# Create a Web application client in Google Cloud Console and add:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Gmail App Password so personal inbox search reads live Gmail.com
# (no Google Cloud client IDs). Create one at https://myaccount.google.com/apppasswords
GMAIL_IMAP_APP_PASSWORD=

